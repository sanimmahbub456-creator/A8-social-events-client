# Public URL of this Next.js app (used by BetterAuth for callback URLs)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Your Express API base URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# MongoDB connection string used by BetterAuth's Mongo adapter (same DB as the server, or its own)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.mongodb.net
DB_NAME=socialEventsDB

# BetterAuth secret (long random string) and the public app URL it trusts
BETTER_AUTH_SECRET=replace_with_a_long_random_string
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth credentials (Google Cloud Console -> OAuth client)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Must match the server's JWT_SECRET so the Express API can verify tokens
JWT_SECRET=replace_with_a_long_random_string
